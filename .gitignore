# =====================================================================
# encryptalotta .gitignore
#
# This is a static site (no build step at the root). The only Node
# tooling lives under tests/ for the Playwright harness. Audit/build
# scripts under scripts/ run via plain `node` with no dependencies.
# =====================================================================

# --------------------
# OS / editor cruft
# --------------------
.DS_Store
.Trashes
._*
.history
Thumbs.db
*.tmp
*.bak
*.orig
*.swp
*.swo
*~
#*#
.claude

# --------------------
# Node tooling (test harness under tests/, ad-hoc local helpers).
# `node_modules/` and `*.log` match at every depth, so `tests/node_modules/`
# and any future nested install are covered automatically.
# --------------------
node_modules/
*.log
.npm
.eslintcache
.cache/
.parcel-cache/

# --------------------
# Environment / secrets — never commit.
# Crypto material globs catch any *.pem / *.key / *.crt / *.p12 / *.pfx /
# *.asc that might end up in the working tree (e.g., test fixtures the
# Playwright suite writes to tests/reports/, which is also ignored below).
# --------------------
.env
.env.*
.dev.vars
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.asc
*.gpg

# --------------------
# IDE
# --------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.iws
*.iml
*.ipr
*.sublime-project
*.sublime-workspace

# --------------------
# Playwright test harness artifacts — the test suite under tests/ writes
# generated fixtures (PNG/JPEG/binary), HTML reports, and screenshot/video
# traces. None of these belong in the public repo. Patterns cover both
# tests/ runs and any stray runs invoked from the repo root.
# --------------------
tests/test-results/
tests/playwright-report/
tests/reports/
test-results/
playwright-report/
playwright/.cache/

# --------------------
# Coverage / archives / Cloudflare Wrangler local state
# --------------------
coverage/
*.zip
*.tar
*.tar.gz
*.tgz
.wrangler/
