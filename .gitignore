# --------------------
# OS / editor cruft
# --------------------
.DS_Store
.Trashes
._*
.history
Thumbs.db
*.tmp
*.bak
*.orig
*.swp
*.swo
*~
#*#
.claude

# --------------------
# Node — this repo has no package.json. The audit / build scripts run via
# plain `node`, but contributors may install local helpers ad-hoc.
# --------------------
node_modules/
*.log

# --------------------
# Environment / secrets — never commit.
# --------------------
.env
.env.*
.dev.vars
*.pem
*.key
*.crt
*.p12

# --------------------
# IDE
# --------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.iws
*.iml
*.ipr
*.sublime-project
*.sublime-workspace
